    "check": "node scripts/check-contract.mjs",
    "check:language:copy": "node --experimental-strip-types scripts/check-language-orders.mjs --tag=check",
    "check:language:branches": "node scripts/check-language-branches.mjs --tag=check"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3"
  }
}
