{
  "name": "zhangyan-workbench-hifi-v0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4260 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/finalize.mjs",
