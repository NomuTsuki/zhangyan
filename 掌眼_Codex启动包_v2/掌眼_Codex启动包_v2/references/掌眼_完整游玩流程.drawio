          <mxGeometry x="160" y="830" width="420" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="relation" value="&lt;b&gt;人物关系变化&lt;/b&gt;&lt;br&gt;再次来访 / 推荐货源 / 关系恶化 / 解锁支线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECF8;strokeColor=#927AB2;fontColor=#243248;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="570" y="830" width="420" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="style" value="&lt;b&gt;店铺身份形成&lt;/b&gt;&lt;br&gt;证据派 / 投机派 / 人情派 / 研究派" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF6EF;strokeColor=#6FA47D;fontColor=#243248;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="980" y="830" width="420" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="distribution" value="&lt;b&gt;案件分布变化&lt;/b&gt;&lt;br&gt;玩家过去行为影响未来来客与风险类型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0F8;strokeColor=#708DB5;fontColor=#243248;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="570" y="1050" width="420" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="daily" value="&lt;b&gt;每日“一眼掌眼”&lt;/b&gt;&lt;br&gt;30—60秒识别关键证据或下一步动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6FA47D;fontColor=#243248;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="160" y="1240" width="420" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="weekly" value="&lt;b&gt;每周主题策展&lt;/b&gt;&lt;br&gt;用收藏、证据和人物故事组成观点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E3;strokeColor=#C99A4A;fontColor=#243248;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="570" y="1240" width="420" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="weekend" value="&lt;b&gt;周末鬼市 / 公共案件&lt;/b&gt;&lt;br&gt;高风险高回报；次日查看玩家统计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECF8;strokeColor=#927AB2;fontColor=#243248;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="980" y="1240" width="420" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="season" value="&lt;b&gt;月度 / 赛季目标&lt;/b&gt;&lt;br&gt;重聚失散套系 / 调查大型来源链 / 举办大型展览" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0F8;strokeColor=#708DB5;fontColor=#243248;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="570" y="1480" width="420" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="next" value="&lt;b&gt;进入下一营业日&lt;/b&gt;&lt;br&gt;新的行情、来客、回执和关系变化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#243B5A;strokeColor=#243B5A;fontColor=#FFFFFF;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="650" y="1740" width="420" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="principles" value="&lt;b&gt;留存设计原则&lt;/b&gt;&lt;br&gt;&lt;br&gt;① 不靠断签惩罚&lt;br&gt;② 回访内容来自玩家昨日行为&lt;br&gt;③ 收藏不仅看稀有度，还看档案完整度&lt;br&gt;④ 成长解锁信息与策略，不替玩家自动判断&lt;br&gt;⑤ 日、周、月目标相互嵌套" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9EE;strokeColor=#D5B56A;fontColor=#745A24;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="90" y="1580" width="420" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="rewards" value="&lt;b&gt;长期可积累内容&lt;/b&gt;&lt;br&gt;&lt;br&gt;器物收藏 / 来源图谱 / 专家联系人&lt;br&gt;NPC关系 / 店铺声誉 / 策展主题&lt;br&gt;检测工具 / 新问题类型 / 新地区案件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#7893B8;fontColor=#314B70;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1190" y="1580" width="420" height="220" as="geometry"/>
