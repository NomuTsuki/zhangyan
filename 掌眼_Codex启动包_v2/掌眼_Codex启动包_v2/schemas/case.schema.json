{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhangyan.local/schemas/case.schema.json",
  "title": "ZhangyanCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "itemTruth",
    "npc",
    "claims",
    "evidence",
    "mainConflict",
    "actionBudget",
    "outcomes"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "itemTruth": {
      "type": "object"
    },
    "npc": {
      "type": "object"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "mainConflict": {
      "type": "string"
    },
    "secondaryConflict": {
      "type": [
        "string",
        "null"
      ]
    },
    "actionBudget": {
      "type": "integer",
      "minimum": 1
    },
    "storylets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
