{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhangyan.local/schemas/storylet.schema.json",
  "title": "Storylet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "conditions",
    "effects",
    "repeatable",
    "priority"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "conditions": {
      "type": "object"
    },
    "effects": {
      "type": "object"
    },
    "repeatable": {
      "type": "boolean"
    },
    "priority": {
      "type": "integer"
    },
    "presentationKey": {
      "type": "string"
    }
  }
}
